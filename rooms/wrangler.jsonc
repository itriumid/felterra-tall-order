/**
 * Felterra: Tall Order's rooms: a host gets a code, and guests use it to find them. A Worker with a
 * Durable Object per room, at rooms.itrium.id and nowhere else (no workers.dev, no preview URLs).
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Deployed by hand from this folder: `pnpm run deploy`.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "itrium-rooms",
	"main": "index.ts",
	"compatibility_date": "2026-10-26",
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "rooms.itrium.id", "custom_domain": true }],
	"durable_objects": {
		"bindings": [{ "name": "ROOM", "class_name": "RoomObject" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject"] }],
	// No logs of requests are kept: not who hosted, not who joined, not from where.
	"observability": { "enabled": false }
}
