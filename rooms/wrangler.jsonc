/**
 * Felterra: Tall Order's rooms: a host gets a code, and guests use it to find them. A Worker with a
 * Durable Object per room, at api.tall-order.felterra.games.itrium.id and nowhere else (no
 * workers.dev, no preview URLs). https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Its own Workers Builds project deploys it: repository itriumid/felterra-tall-order, root
 * directory `rooms`.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "itrium-game-felterra-tall-order-backend",
	"main": "index.ts",
	"compatibility_date": "2026-10-26",
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "api.tall-order.felterra.games.itrium.id", "custom_domain": true }],
	"durable_objects": {
		"bindings": [{ "name": "ROOM", "class_name": "RoomObject" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject"] }],
	// No logs of requests are kept: not who hosted, not who joined, not from where.
	"observability": { "enabled": false }
}
